    // Base URL of the ContentDB site, used to resolve relative asset/release URLs.
    'site_base' => 'https://content.luanti.org',

    // Sent as the User-Agent header on every request to ContentDB.
    'user_agent' => 'ContentDB-Mirror/1.0 (+https://YOUR-SUBDOMAIN.example.com; contact: YOUR_EMAIL)',

    // Delay in microseconds between successive HTTP requests to ContentDB.
